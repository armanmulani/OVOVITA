# ==============================================================================
# Ovovita Farm-to-Table Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas Cloud)
# Local Docker/Windows: mongodb://127.0.0.1:27017/ovovita
# MongoDB Atlas Cloud: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/ovovita?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ovovita

# Authentication & Security
JWT_SECRET=ovovita-farm-fresh-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# NPCI Bharat Dynamic UPI Configuration
UPI_MERCHANT_VPA=ovovita.depot@okhdfcbank
UPI_MERCHANT_NAME=Ovovita Fresh Farms

# Meta WhatsApp Business Cloud API (Meta Developer Portal)
# Graph API endpoint: https://graph.facebook.com/v19.0/{META_PHONE_NUMBER_ID}/messages
META_WHATSAPP_TOKEN=EAAB...your_system_user_token
META_PHONE_NUMBER_ID=109283746501928
META_WEBHOOK_VERIFY_TOKEN=ovovita_meta_challenge_secret_2026

# Redis Cache & Message Queue (Optional for local dev, active in production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
