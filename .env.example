# ==============================================================================
# Ovovita Farm-to-Table Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas Cloud)
# Local Docker/Windows: mongodb://127.0.0.1:27017/ovovita
# MongoDB Atlas Cloud: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/ovovita?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ovovita

# Authentication & Security
JWT_SECRET=ovovita-farm-fresh-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# NPCI Bharat Dynamic UPI Configuration
UPI_MERCHANT_VPA=ovovita.depot@okhdfcbank
UPI_MERCHANT_NAME=Ovovita Fresh Farms

# Meta WhatsApp Business Cloud API (Meta Developer Portal)
# Graph API endpoint: https://graph.facebook.com/v19.0/{META_PHONE_NUMBER_ID}/messages
META_WHATSAPP_TOKEN=EAAB...your_system_user_token
META_PHONE_NUMBER_ID=109283746501928
META_WEBHOOK_VERIFY_TOKEN=ovovita_meta_challenge_secret_2026

# Redis Cache & Message Queue (Optional for local dev, active in production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==============================================================================
# Better Auth Phone OTP Configuration
# ==============================================================================
# The API server owns the OTP flow through Better Auth.
#
# Set ALLOW_DEMO_OTP=true to additionally accept the fixed code `123456`,
# so the client demo and the automated test suites work with no SMS
# provider. The randomly generated code is always printed to the server
# console as well.
#
# This switch is OFF by default and must stay OFF in production — it makes
# every customer account reachable with a publicly known code.
#
# Better Auth secret used to sign session tokens/cookies.
# Falls back to JWT_SECRET when unset.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the API server (used for origin/CSRF checks).
BETTER_AUTH_URL=http://localhost:4000
# Local demo convenience only. NEVER enable on a public deployment.
ALLOW_DEMO_OTP=true

# --- Firebase Web App Configuration ---
# Get from Firebase Console > Project Settings > General > Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ovovita-144d3
VITE_FIREBASE_APP_ID=
# The API verifies Firebase ID tokens using the Firebase Web API key
FIREBASE_WEB_API_KEY=

# --- MSG91 Transactional SMS (production only) ---
# Used by the `sendOTP` hook in
# apps/api-server/src/config/better-auth.ts to deliver real SMS.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=OVOVIT
