{
  "name": "ovovita-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ovovita Farm-to-Table Egg Ordering, Inventory & Delivery Ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently -n \"API,ADMIN,MOBILE\" -c \"blue,green,magenta\" \"npm --workspace=apps/api-server run start\" \"npm --workspace=apps/admin-portal run preview -- --port 5173 --host\" \"npm --workspace=apps/mobile run preview -- --port 5174 --host\"",
    "dev:api": "npm --workspace=apps/api-server run dev",
    "dev:admin": "npm --workspace=apps/admin-portal run dev",
    "dev:mobile": "npm --workspace=apps/mobile run dev",
    "dev:expo": "npm --workspace=apps/expo-mobile run start",
    "seed": "npx ts-node apps/api-server/src/seed.ts",
    "test:core": "npx ts-node apps/api-server/src/__tests__/test_core.ts",
    "test:concurrency": "npx ts-node apps/api-server/src/__tests__/test_concurrency.ts",
    "test:webhook": "npx ts-node apps/api-server/src/__tests__/test_webhook.ts",
    "test:e2e": "npx ts-node apps/api-server/src/__tests__/test_e2e_journey.ts",
    "test:all": "npm run test:core && npm run test:concurrency && npm run test:webhook && npm run test:e2e"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "ts-node": "^10.9.2",
    "zod": "^4.6.7"
  }
}
