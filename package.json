{
  "name": "ovovita-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ovovita Farm-to-Table Egg Ordering, Inventory & Delivery Ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace=apps/api-server run dev",
    "dev:admin": "npm --workspace=apps/admin-portal run dev",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "ts-node": "^10.9.2",
    "zod": "^4.6.7"
  }
}
